[
  {
    "name": "browser_tabs",
    "description": "标签页与导航：list 列标签（query 唯一命中时自动绑定并附视图），open/goto/switch/close/back/forward/reload 管理并自动记住活跃标签，默认附最新标注视图。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["list", "open", "goto", "switch", "close", "back", "forward", "reload"],
          "description": "导航动作"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "http(s) 网址（open/goto）"
        },
        "tab": {
          "type": "string",
          "minLength": 1,
          "description": "完整 tag（省略用已绑定标签；C3 简写仅限已绑定 Chrome 实例）"
        },
        "query": {
          "type": "string",
          "description": "list 按标题/URL 过滤"
        },
        "incognito": {
          "type": "boolean",
          "description": "open 开无痕窗；list 省略列全部，false 普通，true 无痕"
        },
        "view": {
          "type": "boolean",
          "description": "是否附视图与截图，默认 true"
        }
      },
      "required": ["action"],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_view",
    "description": "查看页面交互元素编号清单、正文、焦点与 [id] 标注截图（导航与 act 已附新视图，勿紧接重复调用）。",
    "parameters": {
      "type": "object",
      "properties": {
        "tab": { "type": "string", "minLength": 1, "description": "默认活跃标签" },
        "query": { "type": "string", "description": "关键词过滤" },
        "scope": {
          "type": "string",
          "enum": ["viewport", "all"],
          "description": "viewport（默认）或 all（含屏外）"
        },
        "zoom": {
          "type": "object",
          "properties": {
            "id": { "type": "integer", "minimum": 1, "description": "元素编号" },
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false,
          "description": "按 id 或截图像素矩形局部放大"
        },
        "screenshot": { "type": "boolean", "description": "默认 true；false 仅读 DOM" },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 300, "description": "默认 100" },
        "maxTextChars": { "type": "integer", "minimum": 0, "maximum": 20000, "description": "默认 3000" }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_act",
    "description": "按序执行 1–12 个指针与键盘动作并附新视图。优先传元素 id，无 DOM/Canvas 传截图像素 x/y；type 支持 id 聚焦、clear、submit 及原生 <select> 选值；无确认按钮弹层用 dismiss 收起。",
    "parameters": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "顺序执行的动作步",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": ["click", "type", "hover", "drag", "scroll", "press", "dismiss", "wait", "upload"],
                "description": "动作类型"
              },
              "id": { "type": "integer", "minimum": 1, "description": "元素编号（优先）" },
              "x": { "type": "number", "minimum": 0, "description": "截图像素 X" },
              "y": { "type": "number", "minimum": 0, "description": "截图像素 Y" },
              "button": { "type": "string", "enum": ["left", "right", "middle"], "description": "默认 left" },
              "clicks": { "type": "integer", "minimum": 1, "maximum": 2, "description": "1 单击，2 双击" },
              "text": { "type": "string", "maxLength": 16000, "description": "输入文本或 <select> 选项" },
              "clear": { "type": "boolean", "description": "type 前清空，默认 true" },
              "submit": { "type": "boolean", "description": "type 后按 Enter，默认 false" },
              "x1": { "type": "number", "minimum": 0, "description": "drag 起点 X" },
              "y1": { "type": "number", "minimum": 0, "description": "drag 起点 Y" },
              "x2": { "type": "number", "minimum": 0, "description": "drag 终点 X" },
              "y2": { "type": "number", "minimum": 0, "description": "drag 终点 Y" },
              "durationMs": { "type": "integer", "minimum": 80, "maximum": 1500, "description": "drag 毫秒，默认 240" },
              "dy": { "type": "integer", "minimum": -2400, "maximum": 2400, "description": "纵向滚动像素（正数向下）" },
              "dx": { "type": "integer", "minimum": -2400, "maximum": 2400, "description": "横向滚动像素（正数向右）" },
              "key": { "type": "string", "minLength": 1, "description": "按键名，如 Enter/Tab/Escape/F2/Ctrl+C" },
              "ms": { "type": "integer", "minimum": 0, "maximum": 10000, "description": "wait 毫秒" },
              "selector": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "唯一 file input CSS 选择器" },
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1 },
                "description": "工作区内文件路径"
              }
            },
            "required": ["op"],
            "additionalProperties": false
          }
        },
        "tab": { "type": "string", "minLength": 1, "description": "默认活跃标签" },
        "screenshot": { "type": "boolean", "description": "是否附新图，默认 true" },
        "notes": { "type": "string", "maxLength": 4000, "description": "动作意图备注" }
      },
      "required": ["steps"],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_eval",
    "description": "在页面隔离环境执行只读 JS（支持 Promise，限时 6s），默认只回 JSON value 不截图；禁止用脚本替代 browser_act 点击填写。",
    "parameters": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 32000, "description": "返回可序列化 JSON 的 JS 表达式/IIFE" },
        "tab": { "type": "string", "minLength": 1, "description": "默认活跃标签" },
        "view": { "type": "boolean", "description": "是否附新视图，默认 false" }
      },
      "required": ["code"],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_debug",
    "description": "只读查询 console 日志、network 请求/响应体或 downloads 下载列表（首次查 console/network 自动开始录制）。",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["console", "network", "downloads"], "description": "查询类别" },
        "tab": { "type": "string", "minLength": 1, "description": "默认活跃标签" },
        "query": { "type": "string", "description": "文本/URL 过滤" },
        "level": { "type": "string", "description": "级别过滤（error 含失败/>=400 请求）" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500, "description": "条数上限，默认 100" },
        "requestId": { "type": "string", "description": "读取该请求响应体" },
        "clear": { "type": "boolean", "description": "读后清空缓存" },
        "downloadId": { "type": "string", "description": "单个下载 ID" },
        "since": { "type": "integer", "minimum": 0, "description": "downloads 起始毫秒时间戳" }
      },
      "required": ["kind"],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_experience",
    "description": "站点经验记忆：search 检索路径（task 传 * 列全部），save 保存已验证脱敏路径（redacted=true），feedback 汇报 routeId 复用结果。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["search", "save", "feedback"] },
        "scope": { "type": "string", "minLength": 1, "maxLength": 200, "description": "站点 origin，如 https://github.com" },
        "task": { "type": "string", "minLength": 1, "maxLength": 300, "description": "通用目标（不含业务数据）" },
        "prefix": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "tab": { "type": "string", "minLength": 1 },
        "snapshotId": { "type": "string", "minLength": 1 },
        "recordingId": { "type": "string", "minLength": 1, "description": "剑谱录制 ID（仅 save）" },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "checks": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "pitfalls": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "alternatives": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "at": { "type": "integer", "minimum": 0, "maximum": 12 },
              "actions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
            },
            "required": ["at", "actions"],
            "additionalProperties": false
          }
        },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "redacted": { "type": "boolean" },
        "routeId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "outcome": { "type": "string", "enum": ["success", "failed"] },
        "reason": { "type": "string", "maxLength": 500 }
      },
      "required": ["action", "scope", "task"],
      "additionalProperties": false
    }
  }
]
