[
  {
    "name": "jianlai_windows",
    "description": "列桌面窗口或切窗至前台：list（默认，observe=true 同次附整屏图与 [id] 控件清单，不激活窗口）或 activate（按 windowId 切前台并附新图）。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["list", "activate"], "description": "默认 list" },
        "query": { "type": "string", "minLength": 1, "description": "list 按应用名/标题过滤" },
        "windowId": { "type": "integer", "minimum": 0, "description": "窗口 ID（非 pid；activate 必填）" },
        "observe": { "type": "boolean", "description": "list 时同次截图并附控件清单，默认 false" },
        "background": { "type": "boolean", "description": "独立后台模式（仅 macOS/Linux，list 用）" },
        "maxEdge": {
          "anyOf": [
            { "type": "integer", "enum": [0] },
            { "type": "integer", "minimum": 640, "maximum": 3840 }
          ],
          "description": "长边像素上限：0 原图或 640–3840，默认 1600"
        },
        "notes": { "type": "string", "maxLength": 12000, "description": "观察意图备注" }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "jianlai_view",
    "description": "桌面观察：默认 screenshot=true 截图并附 UIA [id] 控件清单、弹层 overlay 与 scrollHint；screenshot=false 仅读 Windows UIA 控件树；支持 zoom 局部放大。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": ["desktop", "monitor", "window", "zoom"],
          "description": "desktop（默认）/ monitor / window / zoom"
        },
        "windowId": { "type": "integer", "minimum": 0, "description": "目标窗口 ID" },
        "monitorId": { "type": "integer", "minimum": 0, "description": "目标显示器 ID" },
        "zoom": {
          "type": "object",
          "properties": {
            "id": { "type": "integer", "minimum": 1, "description": "按控件编号放大" },
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "space": { "type": "string", "enum": ["image", "source"], "description": "image（默认，需 snapshotId+imageId）或 source（需 windowId/monitorId）" }
          },
          "additionalProperties": false,
          "description": "按 id 或矩形局部放大"
        },
        "snapshotId": { "type": "string", "minLength": 1, "description": "依据的快照 ID" },
        "imageId": { "type": "string", "minLength": 1, "description": "目标图片 ID" },
        "screenshot": { "type": "boolean", "description": "默认 true；false 仅读 UIA 树" },
        "controls": { "type": "boolean", "description": "截图时附带快速 UIA 编号，默认 true" },
        "filter": { "type": "string", "minLength": 1, "maxLength": 60, "description": "控件名/类型过滤" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 6, "description": "screenshot=false 遍历深度，默认 3" },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 120, "description": "控件上限（1–120）" },
        "x": { "type": "integer", "minimum": 0, "description": "screenshot=false 图片像素 X" },
        "y": { "type": "integer", "minimum": 0, "description": "screenshot=false 图片像素 Y" },
        "background": { "type": "boolean", "description": "独立后台模式（仅 macOS/Linux）" },
        "maxEdge": {
          "anyOf": [
            { "type": "integer", "enum": [0] },
            { "type": "integer", "minimum": 640, "maximum": 3840 }
          ],
          "description": "0 或 640–3840"
        },
        "notes": { "type": "string", "maxLength": 12000 }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "jianlai_act",
    "description": "顺序执行 1–16 个真实桌面键鼠动作并附新图与控件清单。优先传控件 id，自绘区传截图像素 x/y；type 整段粘贴（支持 id 聚焦、clear、submit）；弹层无确认用 dismiss；snapshotId 可省略。",
    "parameters": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "顺序执行的动作步",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["click", "double_click", "move", "drag", "type", "press", "scroll", "dismiss", "wait"],
                "description": "动作类型"
              },
              "id": { "type": "integer", "minimum": 1, "description": "控件编号（click/double_click/move/type/scroll）" },
              "x": { "type": "integer", "description": "像素 X（screen 模式可为负）" },
              "y": { "type": "integer", "description": "像素 Y" },
              "toX": { "type": "integer", "description": "drag 终点 X" },
              "toY": { "type": "integer", "description": "drag 终点 Y" },
              "button": { "type": "string", "enum": ["left", "right", "middle"], "description": "默认 left" },
              "text": { "type": "string", "maxLength": 10000, "description": "type 粘贴文本" },
              "clear": { "type": "boolean", "description": "type 前清空，默认 false" },
              "submit": { "type": "boolean", "description": "type 后回车，默认 false" },
              "key": { "type": "string", "minLength": 1, "description": "按键或最多 4 键组合，如 Enter/Ctrl+C/Alt+F4" },
              "delta": { "type": "integer", "minimum": -100, "maximum": 100, "description": "滚轮格数（正数向下/右，约 5–10 格一屏）" },
              "axis": { "type": "string", "enum": ["vertical", "horizontal"], "description": "默认 vertical" },
              "ms": { "type": "integer", "minimum": 0, "maximum": 10000, "description": "wait 毫秒（0–10000）" },
              "glide": { "type": "boolean", "description": "拟人轨迹滑行（默认 true，false 瞬移）" }
            },
            "required": ["action"],
            "additionalProperties": false
          }
        },
        "coordinateSpace": {
          "type": "string",
          "enum": ["image", "screen"],
          "description": "image（默认）或 screen（免截图屏幕物理像素，仅指针动作）"
        },
        "snapshotId": { "type": "string", "description": "可省略（自动绑定最新同模式快照）" },
        "imageId": { "type": "string", "minLength": 1, "description": "多屏快照时指定图片 ID" },
        "windowId": { "type": "integer", "minimum": 0, "description": "后台模式核对窗口" },
        "feedback": {
          "type": "string",
          "enum": ["screenshot", "desktop", "none"],
          "description": "默认 screenshot（同屏）；desktop（全屏）；none（无图）"
        },
        "notes": { "type": "string", "maxLength": 12000, "description": "动作意图备注" },
        "background": { "type": "boolean", "description": "须与快照模式一致" },
        "maxEdge": {
          "anyOf": [
            { "type": "integer", "enum": [0] },
            { "type": "integer", "minimum": 640, "maximum": 3840 }
          ],
          "description": "0 或 640–3840"
        }
      },
      "required": ["actions"],
      "additionalProperties": false
    }
  },
  {
    "name": "jianlai_recall",
    "description": "回看本会话先前保存的桌面截图（只读历史图，不可直接用于输入定位）。",
    "parameters": {
      "type": "object",
      "properties": {
        "imagePath": { "type": "string", "minLength": 1, "description": "本会话桌面截图路径" }
      },
      "required": ["imagePath"],
      "additionalProperties": false
    }
  },
  {
    "name": "jianlai_experience",
    "description": "桌面应用经验记忆：search 按 app(scope) 与目标(task，* 列全部)检索，save 保存已验证脱敏路径（redacted=true），feedback 汇报 routeId 复用结果。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["search", "save", "feedback"] },
        "scope": { "type": "string", "minLength": 1, "maxLength": 200, "description": "应用名（来自 jianlai_windows.app）" },
        "task": { "type": "string", "minLength": 1, "maxLength": 300, "description": "通用目标（不含业务数据）" },
        "prefix": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "snapshotId": { "type": "string", "minLength": 1, "description": "180s 内最新快照 ID（剑谱改传 recordingId）" },
        "recordingId": { "type": "string", "minLength": 1, "description": "剑谱录制 ID（仅 save）" },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "checks": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "pitfalls": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "alternatives": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "at": { "type": "integer", "minimum": 0, "maximum": 12 },
              "actions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
            },
            "required": ["at", "actions"],
            "additionalProperties": false
          }
        },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "redacted": { "type": "boolean" },
        "routeId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "outcome": { "type": "string", "enum": ["success", "transient", "precondition", "invalid"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["action", "scope", "task"],
      "additionalProperties": false
    }
  }
]
