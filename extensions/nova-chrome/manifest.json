{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Nova Chrome",
  "version": "0.1.6",
  "minimum_chrome_version": "125",
  "description": "自动连接 Nova，用稳定 tag 操作 Chrome，快捷复制当前标签页标识。",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "alarms", "downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Nova Chrome", "default_popup": "popup.html"}
}
