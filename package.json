{
  "name": "nova",
  "private": true,
  "version": "0.1.635",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "python scripts/package.py",
    "codebuddy:api": "node scripts/devin-openai.mjs --codebuddy",
    "workbuddy:api": "node scripts/devin-openai.mjs --workbuddy",
    "test:codebuddy-api": "node --test scripts/codebuddy-openai.test.mjs",
    "devin:api": "node scripts/devin-openai.mjs",
    "test:devin-api": "node --test scripts/devin-openai.test.mjs",
    "test:lyra-providers": "node --test scripts/lyra-providers.test.mjs scripts/devin-openai.test.mjs scripts/codebuddy-openai.test.mjs",
    "test:nova-tools-native": "cargo test --manifest-path src-tauri/Cargo.toml nova_tools_native",
    "eval:context-recall": "node scripts/ctx-recall.eval.mjs",
    "eval:context-invoke": "node scripts/ctx-invoke.eval.mjs",
    "test:terminal": "node scripts/terminal-shortcuts.test.mjs && node scripts/workspace-terminal.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.9",
    "exceljs": "^4.4.0",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.13",
    "typebox": "^1.1.38"
