{
  "name": "nova",
  "private": true,
  "version": "0.1.669",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "python scripts/package.py",
    "codebuddy:api": "node scripts/devin-openai.mjs --codebuddy",
    "workbuddy:api": "node scripts/devin-openai.mjs --workbuddy",
    "test:codebuddy-api": "node --test scripts/codebuddy-openai.test.mjs",
    "devin:api": "node scripts/devin-openai.mjs",
    "test:devin-api": "node --test scripts/devin-openai.test.mjs",
    "test:lyra-providers": "node --test scripts/lyra-providers.test.mjs scripts/devin-openai.test.mjs scripts/codebuddy-openai.test.mjs",
    "test:nova-tools-native": "cargo test --manifest-path src-tauri/Cargo.toml nova_tools_native",
    "eval:context-recall": "node scripts/ctx-recall.eval.mjs",
    "eval:context-invoke": "node scripts/ctx-invoke.eval.mjs",
    "test:terminal": "node scripts/terminal-shortcuts.test.mjs && node scripts/workspace-terminal.test.mjs",
    "test:chat-html": "node scripts/transcript-heights.test.mjs && node scripts/html-turn.test.mjs && node scripts/html-prompt-image.test.mjs && node scripts/html-turn-images.test.mjs && node scripts/html-prompt-text.test.mjs && node scripts/markdown-chunks.test.mjs && node scripts/html-transcript.test.mjs",
    "test:solid": "node --test scripts/solid-owner.test.mjs scripts/session-switch.test.mjs scripts/fork-thread.test.mjs scripts/prompt-draft.test.mjs scripts/prompt-queue.test.mjs scripts/history-loading.test.mjs scripts/output-rate.test.mjs scripts/html-prompt-image.test.mjs scripts/miniapps-runtime.test.mjs scripts/image-commands.test.mjs scripts/tool-completion-switch.test.mjs scripts/titlebar-portal.test.mjs",
    "test:chat-scroll": "node scripts/html-transcript.test.mjs --renderer=html --only=scroll-hotpath"
  },
  "devDependencies": {
    "@solidjs/signals": "2.0.0-rc.20",
    "@tauri-apps/cli": "^2.12.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@solidjs/vite-plugin": "3.0.0-next.53"
  },
