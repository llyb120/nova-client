{
  "name": "nova",
  "private": true,
  "version": "0.1.540",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "npm run build:sdk-bridges && vite",
    "build": "npm run build:sdk-bridges:release && vite build",
    "build:sdk-bridges": "npm run build:cursor-bridge && npm run build:nova-tools-mcp",
    "build:sdk-bridges:release": "npm run build:cursor-bridge -- --minify && npm run build:nova-tools-mcp -- --minify",
    "build:cursor-bridge": "esbuild scripts/cursor-bridge.mjs --bundle --platform=node --format=esm --external:bun:sqlite --external:vendor/* --loader:.map=empty --loader:.ts=empty --loader:.schemas=empty --banner:js=\"import{createRequire as __novaCreateRequire}from'node:module';const require=__novaCreateRequire(import.meta.url);\" --outfile=src-tauri/resources/cursor-bridge.mjs",
    "build:nova-tools-mcp": "esbuild scripts/nova-tools-mcp.mjs --bundle --platform=node --format=esm --outfile=src-tauri/resources/nova-tools-mcp.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "python scripts/package.py",
    "test:nova-tools-mcp": "node --test scripts/nova-tools-mcp.test.mjs",
    "test:codex-app-server": "cargo test --manifest-path src-tauri/Cargo.toml --lib codex_app_server",
    "test:nova-tools-native": "cargo test --manifest-path src-tauri/Cargo.toml nova_tools_native",
    "test:context-parity": "node scripts/cursor-context-super.test.mjs",
    "eval:context-recall": "node scripts/ctx-recall.eval.mjs",
    "eval:context-invoke": "node scripts/ctx-invoke.eval.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@cursor/sdk": "^1.0.24",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tencent-ai/agent-sdk": "^0.3.217",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.9",
    "exceljs": "^4.4.0",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.13",
    "typebox": "^1.1.38"
  }
}
