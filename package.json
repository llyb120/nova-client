{
  "name": "nova",
  "private": true,
  "version": "0.1.457",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "npm run build:sdk-bridges && vite",
    "build": "npm run build:sdk-bridges:release && vite build",
    "build:sdk-bridges": "npm run build:opencode-bridge && npm run build:alkaid-bridge && npm run build:codex-bridge && npm run build:codebuddy-bridge && npm run build:claude-bridge && npm run build:cursor-bridge && npm run build:nova-tools-mcp",
    "build:sdk-bridges:release": "npm run build:opencode-bridge -- --minify && npm run build:alkaid-bridge -- --minify && npm run build:codex-bridge -- --minify && npm run build:codebuddy-bridge -- --minify && npm run build:claude-bridge -- --minify && npm run build:cursor-bridge -- --minify && npm run build:nova-tools-mcp -- --minify",
    "build:opencode-bridge": "esbuild scripts/opencode-bridge.mjs --bundle --platform=node --format=cjs --outfile=src-tauri/resources/opencode-bridge.cjs",
    "build:alkaid-bridge": "node scripts/build-alkaid-bridge.mjs",
    "build:codex-bridge": "esbuild scripts/codex-bridge.mjs --bundle --platform=node --format=esm --outfile=src-tauri/resources/codex-bridge.mjs",
    "build:codebuddy-bridge": "esbuild scripts/codebuddy-bridge.mjs --bundle --platform=node --format=cjs --outfile=src-tauri/resources/codebuddy-bridge.cjs",
    "build:claude-bridge": "esbuild scripts/claude-bridge.mjs --bundle --platform=node --format=esm --outfile=src-tauri/resources/claude-bridge.mjs",
    "build:cursor-bridge": "esbuild scripts/cursor-bridge.mjs --bundle --platform=node --format=esm --external:bun:sqlite --external:vendor/* --loader:.map=empty --loader:.ts=empty --loader:.schemas=empty --banner:js=\"import{createRequire as __novaCreateRequire}from'node:module';const require=__novaCreateRequire(import.meta.url);\" --outfile=src-tauri/resources/cursor-bridge.mjs",
    "build:nova-tools-mcp": "esbuild scripts/nova-tools-mcp.mjs --bundle --platform=node --format=esm --outfile=src-tauri/resources/nova-tools-mcp.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "python scripts/package.py",
    "alkaid": "node scripts/alkaid.mjs",
    "test:alkaid": "node --test scripts/alkaid.test.mjs",
    "test:nova-tools-mcp": "node --test scripts/nova-tools-mcp.test.mjs",
    "test:nova-tools-native": "cargo test --manifest-path src-tauri/Cargo.toml nova_tools_native",
    "test:context-parity": "node scripts/audit-context-parity.mjs && node scripts/alkaid-context-super.test.mjs && node scripts/cursor-context-super.test.mjs",
    "eval:context-recall": "node scripts/ctx-recall.eval.mjs",
    "eval:context-invoke": "node scripts/ctx-invoke.eval.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.211",
    "@cursor/sdk": "^1.0.24",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.144.5",
    "@opencode-ai/sdk": "^1.18.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tencent-ai/agent-sdk": "^0.3.217",
    "diff": "^9.0.0",
    "dompurify": "^3.4.9",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.13",
    "typebox": "^1.1.38"
  }
}
